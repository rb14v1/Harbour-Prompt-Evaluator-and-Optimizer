# =======================================================
# Prompt Evaluation & Optimization System Environment Configuration
# =======================================================

# Django Settings (required)
DJANGO_SECRET_KEY=
# Comma-separated list of host names, e.g. localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=

# Django Settings (optional)
# True/1 to enable debug mode; defaults to False
DJANGO_DEBUG=
# Comma-separated list of allowed CORS origins; empty allows all origins
CORS_ALLOWED_ORIGINS=
# Comma-separated list of trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=
# Default cache timeout in seconds; defaults to 300
CACHE_TIMEOUT=

# Azure OpenAI Credentials (Recommended)
# When provided, all LLM operations utilize your Azure OpenAI deployment.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Direct OpenAI Configuration (Alternative)
OPENAI_API_KEY=
OPENAI_MODEL=

# PostgreSQL (Azure). Leave POSTGRES_HOST empty to use local SQLite (db.sqlite3).
# When POSTGRES_HOST is set, POSTGRES_USER and POSTGRES_PASSWORD are required.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Note: If no API key is set, the system automatically runs with
# high-quality intelligent deterministic generation for evaluation,
# synthetic test datasets, and prompt optimization.
